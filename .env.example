# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
#
# NEXT_PUBLIC_* is compiled into the browser bundle and is readable by anyone
# who opens devtools. Everything without that prefix is server-only and must
# never be imported into a Client Component.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → service_role. Server-only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → the database password you chose at project creation. Used by the
# Supabase CLI to push migrations; not read by the application.
SUPABASE_DB_PASSWORD=

# Stripe → Developers → API keys. TEST MODE ONLY — both must contain "test".
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Printed by `stripe listen` locally; set from the Stripe dashboard in production.
STRIPE_WEBHOOK_SECRET=

# Absolute origin, used to build Stripe success/cancel URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
